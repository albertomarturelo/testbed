{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "casefile run event (.runs/*.jsonl line)",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^TC-[0-9]{4,}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked",
        "skipped",
        "not_run"
      ]
    },
    "executor": {
      "type": "string",
      "pattern": "^(human|agent|ci):.+$"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "surface": {
      "type": "string",
      "enum": [
        "web",
        "mobile-ios",
        "mobile-android",
        "backend",
        "api",
        "cli",
        "desktop"
      ]
    },
    "env": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "step_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "blocked",
              "skipped",
              "not_run"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "step",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "automation_ref": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "triage": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "defect",
            "test_bug",
            "known_issue",
            "flaky",
            "environment"
          ]
        },
        "by": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "expires": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "by"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "run_id",
    "case_id",
    "status",
    "executor",
    "at"
  ],
  "additionalProperties": false
}
