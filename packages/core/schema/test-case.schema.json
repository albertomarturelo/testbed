{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "casefile test case (frontmatter)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TC-[0-9]{4,}$"
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "active",
        "retired"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "import"
      ]
    },
    "acceptance_ref": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "surfaces": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "web",
          "mobile-ios",
          "mobile-android",
          "backend",
          "api",
          "cli",
          "desktop"
        ]
      }
    },
    "layer": {
      "type": "string",
      "enum": [
        "e2e",
        "integration",
        "api",
        "ui",
        "unit",
        "manual-exploratory"
      ]
    },
    "automation": {
      "type": "object",
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "manual",
            "candidate",
            "in_progress",
            "retired"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {}
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "do": {
            "type": "string",
            "minLength": 1
          },
          "expect": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "do",
          "expect"
        ],
        "additionalProperties": false
      }
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*:\\S+$"
      }
    },
    "duplicates_checked_against": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TC-[0-9]{4,}$"
      }
    },
    "mirror": {
      "type": "object",
      "properties": {
        "zephyr": {
          "type": "string",
          "minLength": 1
        },
        "xray": {
          "type": "string",
          "minLength": 1
        },
        "testrail": {
          "type": "string",
          "minLength": 1
        },
        "synced_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "history": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "by": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+$"
          },
          "via": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "inbox": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "enum": [
              "created",
              "updated",
              "state_changed",
              "review_requested",
              "reviewed",
              "imported",
              "synced",
              "retired"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "at",
          "by",
          "via",
          "change",
          "event"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "feature",
    "title",
    "state",
    "origin",
    "steps",
    "history"
  ],
  "additionalProperties": false
}
