{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "casefile.workspace.yaml",
  "type": "object",
  "properties": {
    "repos": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "repos"
  ],
  "additionalProperties": false
}
