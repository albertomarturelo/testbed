{
  "name": "@casefile/core",
  "version": "0.0.0",
  "description": "casefile core: test cases as files in your repository — schemas, resolver, query DSL, operations.",
  "license": "MIT",
  "keywords": [
    "testing",
    "test-cases",
    "qa",
    "test-management",
    "ai-agent",
    "library"
  ],
  "homepage": "https://github.com/albertomarturelo/testbed#readme",
  "bugs": {
    "url": "https://github.com/albertomarturelo/testbed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertomarturelo/testbed.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "schema",
    "specs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "schemas": "node scripts/gen-schemas.mjs",
    "prepack": "node -e \"require('node:fs').cpSync('../../LICENSE','LICENSE')\"",
    "postpack": "node -e \"require('node:fs').rmSync('LICENSE',{force:true})\""
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
