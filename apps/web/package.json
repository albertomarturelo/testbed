{
  "name": "@casefile/web",
  "version": "0.2.1",
  "description": "casefile viewer: the local UI where a QA reads, edits and approves the test cases kept in the repository.",
  "license": "MIT",
  "keywords": [
    "testing",
    "test-cases",
    "qa",
    "test-management",
    "ai-agent",
    "ui"
  ],
  "homepage": "https://github.com/albertomarturelo/testbed#readme",
  "bugs": {
    "url": "https://github.com/albertomarturelo/testbed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertomarturelo/testbed.git",
    "directory": "apps/web"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "casefile-web": "./dist/server/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "dev": "vite",
    "prepack": "node -e \"require('node:fs').cpSync('../../LICENSE','LICENSE')\"",
    "postpack": "node -e \"require('node:fs').rmSync('LICENSE',{force:true})\""
  },
  "dependencies": {
    "@casefile/core": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "happy-dom": "20.14.6",
    "lucide-react": "1.54.0",
    "markdown-it": "15.0.3",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.4"
  }
}
