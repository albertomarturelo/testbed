{
  "name": "@casefile/cli",
  "version": "0.1.0",
  "description": "Test cases belong in the repository. Agent proposes, human decides.",
  "license": "MIT",
  "keywords": [
    "testing",
    "test-cases",
    "qa",
    "test-management",
    "ai-agent",
    "cli"
  ],
  "homepage": "https://github.com/albertomarturelo/testbed#readme",
  "bugs": {
    "url": "https://github.com/albertomarturelo/testbed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertomarturelo/testbed.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "casefile": "./dist/bin.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node -e \"const fs=require('node:fs');fs.rmSync('skills',{recursive:true,force:true});fs.cpSync('../../skills','skills',{recursive:true});fs.cpSync('../../README.md','README.md');fs.cpSync('../../LICENSE','LICENSE')\"",
    "postpack": "node -e \"const fs=require('node:fs');for(const p of ['skills','README.md','LICENSE'])fs.rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@casefile/core": "workspace:*"
  },
  "devDependencies": {
    "zod": "4.6.5"
  }
}
