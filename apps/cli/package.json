{
  "name": "@casefile/cli",
  "version": "0.0.0",
  "description": "Test cases belong in the repository. Agent proposes, human decides.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "casefile": "./dist/bin.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node -e \"const fs=require('node:fs');fs.rmSync('skills',{recursive:true,force:true});fs.cpSync('../../skills','skills',{recursive:true})\"",
    "postpack": "node -e \"require('node:fs').rmSync('skills',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@casefile/core": "workspace:*"
  },
  "devDependencies": {
    "zod": "4.6.5"
  }
}
